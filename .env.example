EVENTLAKE_HTTP_HOST=0.0.0.0
EVENTLAKE_HTTP_PORT=8080
# Comma-separated allowlist of CORS origins. Empty = permissive (development only).
EVENTLAKE_CORS_ALLOWED_ORIGINS=

# Operational metadata SQLite database path
EVENTLAKE_DATABASE_URL=sqlite://data/eventlake.db?mode=rwc
EVENTLAKE_DATABASE_MAX_CONNECTIONS=5

# ClickHouse raw-event lake configuration (mandatory in single-lake architecture)
EVENTLAKE_CLICKHOUSE_ENABLED=true
EVENTLAKE_CLICKHOUSE_URL=http://eventlake:eventlake@clickhouse:8123/eventlake

# Set a strong secret. Startup fails if this stays "change-me" while auth is enabled.
EVENTLAKE_JWT_SECRET=change-me
EVENTLAKE_REQUIRE_AUTHENTICATION=false
EVENTLAKE_BACKGROUND_WORKERS_ENABLED=true

# Collector worker concurrency (default: 8)
EVENTLAKE_COLLECTOR_CONCURRENCY=8
# Maximum contract addresses batched into a single eth_getLogs call (default: 50)
EVENTLAKE_COLLECTOR_MAX_BATCH_ADDRESSES=50

# Block & Transaction synchronization
EVENTLAKE_BLOCK_TRANSACTION_ENABLED=false
EVENTLAKE_BLOCK_TRANSACTION_BATCH_SIZE=10
EVENTLAKE_BLOCK_TRANSACTION_MAX_CONCURRENCY=2
EVENTLAKE_BLOCK_TRANSACTION_REORG_WINDOW=32

EVENTLAKE_LOG_LEVEL=info
EVENTLAKE_JSON_LOGS=false
# Optional JSON file path for bootstrapping chain RPC pools at startup.
EVENTLAKE_RPC_SEEDS_PATH=config/rpc_endpoints.json

# ==============================================================================
# Backup & Restore Configuration (Local & S3 / MinIO / Cloudflare R2)
# ==============================================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
BACKUP_S3_BUCKET=my-eventlake-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=eventlake
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ==============================================================================
# Docker Build & Prebuilt Binary Download Configuration (Optional)
# ==============================================================================
# EVENTLAKE_VERSION=latest
# EVENTLAKE_CN_PROXY=false
# EVENTLAKE_GITHUB_REPO=xzsean666/EVMEventLake
# EVENTLAKE_DOWNLOAD_URL=
