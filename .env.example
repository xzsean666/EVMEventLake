EVENTLAKE_HTTP_HOST=0.0.0.0
EVENTLAKE_HTTP_PORT=8080
# Comma-separated allowlist of CORS origins. Empty = permissive (development only).
EVENTLAKE_CORS_ALLOWED_ORIGINS=
EVENTLAKE_DATABASE_URL=postgres://eventlake:eventlake@postgres:5432/eventlake
EVENTLAKE_DATABASE_MAX_CONNECTIONS=20
# ClickHouse is optional and disabled by default. When enabled, it is the raw EVM-log
# store; PostgreSQL keeps only operational state. Build with --features clickhouse.
# Configure ClickHouse via URL (recommended):
EVENTLAKE_CLICKHOUSE_URL=http://eventlake:eventlake@clickhouse:8123/eventlake
EVENTLAKE_CLICKHOUSE_ENABLED=false
# Legacy individual settings (can also be used as fine-grained overrides):
# EVENTLAKE_CLICKHOUSE_HOST=clickhouse
# EVENTLAKE_CLICKHOUSE_PORT=8123
# EVENTLAKE_CLICKHOUSE_USER=eventlake
# EVENTLAKE_CLICKHOUSE_PASSWORD=eventlake
# EVENTLAKE_CLICKHOUSE_DB=eventlake
# Set a strong secret. Startup fails if this stays "change-me" while auth is enabled.
EVENTLAKE_JWT_SECRET=change-me
EVENTLAKE_REQUIRE_AUTHENTICATION=false
EVENTLAKE_BACKGROUND_WORKERS_ENABLED=true
EVENTLAKE_WORKER_TICK_SECONDS=5
# Deprecated compatibility setting. EventLake no longer starts a decoder.
EVENTLAKE_DECODE_BATCH_SIZE=100
# Partition maintenance runs DDL, so it ticks slower than the collector.
EVENTLAKE_PARTITION_TICK_SECONDS=300
EVENTLAKE_LOG_LEVEL=info
EVENTLAKE_JSON_LOGS=false
# Optional JSON file path for bootstrapping chain RPC pools at startup.
# Defaults to config/rpc_endpoints.json if the file exists.
EVENTLAKE_RPC_SEEDS_PATH=config/rpc_endpoints.json

# Optional Docker-internal SSH tunnel proxy.
# Default is disabled. Set SSH_TUNNEL_ENABLED=true and fill SSH_TUNNEL_HOST to use it.
SSH_TUNNEL_ENABLED=false
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=root
SSH_TUNNEL_SOCKS_BIND_HOST=127.0.0.1
SSH_TUNNEL_SOCKS_PORT=1080
# Recommended: put a base64-encoded private key here to avoid multiline env parsing issues.
# Example: base64 -w0 ~/.ssh/id_ed25519
SSH_TUNNEL_PRIVATE_KEY_B64=
# Alternative: private key text with literal \n separators or real newlines if your env loader supports them.
SSH_TUNNEL_PRIVATE_KEY=
# Alternative: mount a key file into the container and set this path.
SSH_TUNNEL_PRIVATE_KEY_FILE=
# Optional known_hosts text. If empty, StrictHostKeyChecking defaults to accept-new.
SSH_TUNNEL_KNOWN_HOSTS=
SSH_TUNNEL_STRICT_HOST_KEY_CHECKING=accept-new
# Keep local Docker services off the proxy.
SSH_TUNNEL_NO_PROXY=127.0.0.1,localhost,::1,postgres,clickhouse,eventlake
